# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets. .env is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# GitHub Personal Access Token (needs repo + actions + contents scopes)
GITHUB_PAT=

# (Optional) Default repository to scan if none is provided via the UI (owner/repo format)
GITHUB_REPO=

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
# Supports comma-separated keys for round-robin load balancing, e.g.: KEY1,KEY2,KEY3
GEMINI_API_KEY=

# ── Jira Integration ──────────────────────────────────────────────────────────
# Your Atlassian/Jira Cloud instance URL (no trailing slash)
JIRA_URL=

# Jira account email address
JIRA_EMAIL=

# Jira API Token (https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=

# Jira project key (e.g. SCRUM, TEST, PROJ)
JIRA_PROJECT_KEY=

# Target Jira issue status when pushing test cases (e.g. "In Progress", "To Do")
JIRA_FEATURE_STATUS=In Progress

# ── API / CORS ────────────────────────────────────────────────────────────────
# Comma-separated allowed origins for the FastAPI CORS middleware.
# Use "*" only for local development — set your real frontend URL in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Defaults ─────────────────────────────────────────────────────────────────
# Default Git branch name used when fetching commits and triggering workflows.
DEFAULT_BRANCH=main

# Default Java package fallback when package cannot be inferred from file path.
DEFAULT_JAVA_PACKAGE=com.example
